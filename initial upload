    "FIT_GLMM = True\n",
    "\n",
    "GLMM_FITTED = False\n",
    "glmm_results_table = pd.DataFrame()\n",
    "\n",
    "if (\n",
    "    FIT_GLMM\n",
    "    and not decision_analysis_df.empty\n",
    "):\n",
    "    glmm_traits = [\n",
    "        column\n",
    "        for column in [\n",
    "            \"openness\",\n",
    "            \"conscientiousness\",\n",
    "            \"extraversion\",\n",
    "            \"agreeableness\",\n",
    "            \"neuroticism\",\n",
    "            \"trust_level\",\n",
    "            \"scepticism\",\n",
    "            \"digital_literacy\",\n",
    "        ]\n",
    "        if column in decision_analysis_df.columns\n",
    "    ]\n",
    "\n",
    "    glmm_required = (\n",
    "        [\n",
    "            \"shared\",\n",
    "            \"run_id\",\n",
    "            \"agent_cluster_id\",\n",
    "            \"information_type_norm\",\n",
    "            \"model\",\n",
    "            \"topology\",\n",
    "        ]\n",
    "        + glmm_traits\n",
    "    )\n",
    "\n",
    "    glmm_df = decision_analysis_df.dropna(\n",
    "        subset=glmm_required\n",
    "    ).copy()\n",
    "\n",
    "    if (\n",
    "        len(glmm_df) >= 100\n",
    "        and glmm_df[\"shared\"].nunique() == 2\n",
    "    ):\n",
    "        fixed_terms = \" + \".join(\n",
    "            glmm_traits\n",
    "        )\n",
    "\n",
    "        formula = (\n",
    "            \"shared ~ \"\n",
    "            + fixed_terms\n",
    "            + \" + C(information_type_norm)\"\n",
    "            + \" + C(model)\"\n",
    "            + \" + C(topology)\"\n",
    "        )\n",
    "\n",
    "        if \"conscientiousness\" in glmm_traits:\n",
    "            formula += (\n",
    "                \" + conscientiousness:\"\n",
    "                \"C(information_type_norm)\"\n",
    "            )\n",
    "\n",
    "        variance_components = {\n",
    "            \"simulation_run\": \"0 + C(run_id)\",\n",
    "            \"agent_id\": \"0 + C(agent_cluster_id)\",\n",
    "        }\n",
    "\n",
    "        try:\n",
    "            glmm_model = (\n",
    "                BinomialBayesMixedGLM.from_formula(\n",
    "                    formula,\n",
    "                    variance_components,\n",
    "                    glmm_df,\n",
    "                )\n",
    "            )\n",
    "\n",
    "            glmm_fit = glmm_model.fit_vb()\n",
    "\n",
    "            GLMM_FITTED = True\n",
    "\n",
    "            fixed_names = (\n",
    "                glmm_model.exog_names\n",
    "            )\n",
    "\n",
    "            fixed_mean = (\n",
    "                glmm_fit.fe_mean\n",
    "            )\n",
    "\n",
    "            fixed_sd = (\n",
    "                glmm_fit.fe_sd\n",
    "            )\n",
    "\n",
    "            z_values = (\n",
    "                fixed_mean\n",
    "                / fixed_sd\n",
    "            )\n",
    "\n",
    "            p_values = 2 * (\n",
    "                1\n",
    "                - norm.cdf(\n",
    "                    np.abs(z_values)\n",
    "                )\n",
    "            )\n",
    "\n",
    "            glmm_results_table = pd.DataFrame({\n",
    "                \"term\": fixed_names,\n",
    "                \"log_odds\": fixed_mean,\n",
    "                \"std_error_approx\": fixed_sd,\n",
    "                \"odds_ratio\": np.exp(\n",
    "                    fixed_mean\n",
    "                ),\n",
    "                \"z_approx\": z_values,\n",
    "                \"p_value_approx\": p_values,\n",
    "            })\n",
    "\n",
    "            glmm_results_table.to_csv(\n",
    "                TABLES_PATH\n",
    "                / \"phase21_glmm_fixed_effects.csv\",\n",
    "                index=False,\n",
    "            )\n",
    "\n",
    "            with open(\n",
    "                ANALYSIS_PATH\n",
    "                / \"phase21_glmm_summary.txt\",\n",
    "                \"w\",\n",
    "                encoding=\"utf-8\",\n",
    "            ) as file:\n",
    "                file.write(\n",
    "                    str(\n",
    "                        glmm_fit.summary()\n",
    "                    )\n",
    "                )\n",
    "\n",
    "            print(\n",
    "                glmm_fit.summary()\n",
    "            )\n",
    "\n",
    "            display(\n",
    "                glmm_results_table\n",
    "            )\n",
    "\n",
    "        except Exception as exc:\n",
    "            print(\n",
    "                \"GLMM fitting failed:\",\n",
    "                repr(exc),\n",
    "            )\n",
    "\n",
    "            with open(\n",
    "                ANALYSIS_PATH\n",
    "                / \"phase21_glmm_error.txt\",\n",
    "                \"w\",\n",
    "                encoding=\"utf-8\",\n",
    "            ) as file:\n",
    "                file.write(\n",
    "                    repr(exc)\n",
    "                )\n",
    "\n",
    "    else:\n",
    "        print(\n",
    "            \"The GLMM needs at least 100 valid decisions \"\n",
    "            \"with both SHARE and non-SHARE outcomes.\"\n",
    "        )\n",
    "else:\n",
    "    print(\n",
    "        \"GLMM is OFF or agent-level data are unavailable.\"\n",
    "    )\n",
    "\n",
    "print(\n",
    "    \"GLMM fitted:\",\n",
    "    GLMM_FITTED\n",
    ")"
