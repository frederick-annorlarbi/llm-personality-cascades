    "def calculate_cascade_depth(\n",
    "    decision_group\n",
    "):\n",
    "    if (\n",
    "        decision_group.empty\n",
    "        or \"source_agent_id\"\n",
    "        not in decision_group.columns\n",
    "    ):\n",
    "        return 0\n",
    "\n",
    "    successful = decision_group[\n",
    "        decision_group[\"decision\"] == \"SHARE\"\n",
    "    ].dropna(\n",
    "        subset=[\n",
    "            \"source_agent_id\",\n",
    "            \"agent_id\",\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    if successful.empty:\n",
    "        return 0\n",
    "\n",
    "    graph = nx.DiGraph()\n",
    "\n",
    "    for _, row in successful.iterrows():\n",
    "        source = int(\n",
    "            row[\"source_agent_id\"]\n",
    "        )\n",
    "\n",
    "        target = int(\n",
    "            row[\"agent_id\"]\n",
    "        )\n",
    "\n",
    "        if source >= 0 and source != target:\n",
    "            graph.add_edge(\n",
    "                source,\n",
    "                target,\n",
    "            )\n",
    "\n",
    "    if graph.number_of_edges() == 0:\n",
    "        return 0\n",
    "\n",
    "    target_nodes = set(\n",
    "        successful[\"agent_id\"].astype(int)\n",
    "    )\n",
    "\n",
    "    source_nodes = set(\n",
    "        successful[\"source_agent_id\"].astype(int)\n",
    "    )\n",
    "\n",
    "    roots = [\n",
    "        node\n",
    "        for node in source_nodes\n",
    "        if (\n",
    "            node not in target_nodes\n",
    "            and node in graph.nodes\n",
    "        )\n",
    "    ]\n",
    "\n",
    "    if not roots:\n",
    "        roots = list(\n",
    "            source_nodes.intersection(\n",
    "                graph.nodes\n",
    "            )\n",
    "        )\n",
    "\n",
    "    max_depth = 0\n",
    "\n",
    "    for root in roots:\n",
    "        lengths = nx.single_source_shortest_path_length(\n",
    "            graph,\n",
    "            root,\n",
    "        )\n",
    "\n",
    "        if lengths:\n",
    "            max_depth = max(\n",
    "                max_depth,\n",
    "                max(lengths.values()),\n",
    "            )\n",
    "\n",
    "    return int(max_depth)\n",
    "\n",
    "\n",
    "def first_step_reaching(\n",
    "    cascade_group,\n",
    "    threshold,\n",
    "):\n",
    "    reached = cascade_group[\n",
    "        cascade_group[\"total_seen\"] >= threshold\n",
    "    ]\n",
    "\n",
    "    if reached.empty:\n",
    "        return np.nan\n",
    "\n",
    "    return float(\n",
    "        reached.sort_values(\n",
    "            \"step\"\n",
    "        ).iloc[0][\"step\"]\n",
    "    )\n",
