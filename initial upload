    "\n",
    "    observed_actions = set(\n",
    "        combined_decisions_df[\n",
    "            \"decision\"\n",
    "        ].astype(str).str.upper().unique()\n",
    "    )\n",
    "\n",
    "    audit(\n",
    "        \"valid decision labels\",\n",
    "        observed_actions.issubset(valid_actions),\n",
