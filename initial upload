    "### Validate LLM output and define fallback behaviour\n",
    "\n",
    "This cell contains the response parser, strict-mode error handling, and heuristic fallback logic.\n",
    "\n",
    "**For the real experiment:** strict mode is intended to prevent fallback decisions from contaminating the LLM dataset.\n",
    "\n",
    "**For smoke tests:** fallback logic can help test the simulation mechanics without requiring a live model for every call.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "d1841415",
   "metadata": {},
   "outputs": [],
   "source": [
    "class StrictModeLLMError(RuntimeError):\n",
    "    pass\n",
    "\n",
    "\n",
    "def fallback_decision(\n",
    "    agent,\n",
    "    information,\n",
    "    rng=None,\n",
    "):\n",
    "    if rng is None:\n",
    "        rng = np.random.default_rng()\n",
    "\n",
    "    score = 0.20\n",
    "    score += agent[\"trust_level\"] * 0.20\n",
    "    score += agent[\"extraversion\"] * 0.18\n",
    "    score += agent[\"agreeableness\"] * 0.15\n",
    "\n",
    "    if information[\"emotional_intensity\"] == \"high\":\n",
    "        score += agent[\"neuroticism\"] * 0.18\n",
    "    else:\n",
    "        score += agent[\"neuroticism\"] * 0.05\n",
    "\n",
    "    if information[\"information_type\"] != \"true\":\n",
    "        score -= agent[\"conscientiousness\"] * 0.25\n",
    "    else:\n",
    "        score -= agent[\"conscientiousness\"] * 0.05\n",
    "\n",
    "    score -= agent[\"scepticism\"] * 0.22\n",
    "    score -= agent[\"digital_literacy\"] * 0.12\n",
    "\n",
    "    if information[\"source_credibility\"] == \"low\":\n",
    "        score -= 0.20\n",
    "\n",
    "    share_probability = float(\n",
    "        np.clip(score, 0.02, 0.90)\n",
    "    )\n",
    "\n",
    "    if rng.random() < share_probability:\n",
    "        return \"SHARE\"\n",
    "\n",
    "    if (\n",
    "        agent[\"scepticism\"] >= 0.55\n",
    "        or agent[\"digital_literacy\"] >= 0.60\n",
    "    ):\n",
    "        return \"VERIFY\"\n",
    "\n",
    "    return \"IGNORE\"\n",
    "\n",
    "\n",
    "def call_llm_with_retry(\n",
    "    prompt,\n",
    "    llm_instance,\n",
    "    max_retries=MAX_RETRIES,\n",
    "    base_delay=RETRY_BASE_DELAY,\n",
    "    strict=True,\n",
    "):\n",
    "    last_error = None\n",
    "\n",
    "    for attempt in range(max_retries + 1):\n",
    "        try:\n",
    "            return llm_instance.invoke(prompt)\n",
    "\n",
    "        except Exception as exc:\n",
    "            last_error = exc\n",
    "\n",
    "            if attempt >= max_retries:\n",
    "                break\n",
    "\n",
    "            wait = base_delay * (2 ** attempt)\n",
    "\n",
    "            print(\n",
    "                f\"[retry] {type(exc).__name__}; \"\n",
    "                f\"waiting {wait:.1f}s \"\n",
    "                f\"({attempt + 1}/{max_retries})\"\n",
    "            )\n",
    "\n",
    "            time.sleep(wait)\n",
    "\n",
    "    if strict:\n",
    "        raise StrictModeLLMError(\n",
    "            f\"LLM call failed after retries: {last_error}\"\n",
    "        )\n",
    "\n",
    "    raise last_error\n",
    "\n",
    "\n",
    "def make_agent_decision(\n",
    "    agent,\n",
    "    information,\n",
    "    social_context,\n",
    "    model_name,\n",
    "    use_llm=True,\n",
    "    strict=True,\n",
    "    decision_seed=None,\n",
    "):\n",
    "    rng = np.random.default_rng(\n",
    "        decision_seed\n",
    "        if decision_seed is not None\n",
    "        else RANDOM_SEED\n",
    "    )\n",
    "\n",
    "    if not use_llm:\n",
    "        return {\n",
    "            \"agent_id\": agent[\"agent_id\"],\n",
    "            \"decision\": fallback_decision(\n",
    "                agent,\n",
    "                information,\n",
    "                rng=rng,\n",
    "            ),\n",
    "            \"reason\": \"Rule-based diagnostic decision.\",\n",
    "            \"llm_response\": \"\",\n",
    "            \"used_llm\": False,\n",
    "            \"fallback_used\": True,\n",
    "        }\n",
    "\n",
    "    prompt = create_llm_decision_prompt(\n",
    "        agent,\n",
    "        information,\n",
    "        social_context,\n",
    "    )\n",
    "\n",
    "    llm_instance = get_llm(model_name)\n",
    "\n",
    "    last_response = \"\"\n",
    "\n",
    "    for _ in range(3):\n",
    "        response = call_llm_with_retry(\n",
    "            prompt,\n",
    "            llm_instance,\n",
    "            strict=strict,\n",
    "        )\n",
    "\n",
    "        last_response = response.content\n",
    "        decision = extract_decision(\n",
    "            response.content\n",
    "        )\n",
    "\n",
    "        if decision != \"UNKNOWN\":\n",
    "            return {\n",
    "                \"agent_id\": agent[\"agent_id\"],\n",
    "                \"decision\": decision,\n",
    "                \"reason\": extract_reason(\n",
    "                    response.content\n",
    "                ),\n",
    "                \"llm_response\": response.content,\n",
    "                \"used_llm\": True,\n",
    "                \"fallback_used\": False,\n",
    "            }\n",
    "\n",
    "    if strict:\n",
    "        raise StrictModeLLMError(\n",
    "            f\"Agent {agent['agent_id']} produced an \"\n",
    "            f\"unparseable response: {last_response[:200]}\"\n",
    "        )\n",
    "\n",
    "    return {\n",
    "        \"agent_id\": agent[\"agent_id\"],\n",
    "        \"decision\": fallback_decision(\n",
    "            agent,\n",
    "            information,\n",
    "            rng=rng,\n",
    "        ),\n",
    "        \"reason\": \"Fallback used after unparseable LLM output.\",\n",
    "        \"llm_response\": last_response,\n",
    "        \"used_llm\": False,\n",
    "        \"fallback_used\": True,\n",
    "    }"
   ]
  },
