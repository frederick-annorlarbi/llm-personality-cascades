    "AGE_GROUPS = [\"18-24\", \"25-34\", \"35-44\", \"45-54\", \"55-64\", \"65+\"]\n",
    "GENDERS = [\"Male\", \"Female\", \"Non-binary\"]\n",
    "EDUCATION_LEVELS = [\n",
    "    \"Secondary\", \"Diploma\", \"Undergraduate\", \"Postgraduate\"\n",
    "]\n",
    "OCCUPATIONS = [\n",
    "    \"Student\", \"Teacher\", \"Accountant\", \"Engineer\", \"Administrator\",\n",
    "    \"Nurse\", \"Researcher\", \"Retail Worker\", \"Business Owner\", \"Designer\"\n",
    "]\n",
    "POLITICAL_LEANINGS = [\n",
    "    \"Left\", \"Centre-left\", \"Centre\", \"Centre-right\", \"Right\", \"Undisclosed\"\n",
    "]\n",
    "\n",
    "BIG5 = [\n",
    "    \"openness\",\n",
    "    \"conscientiousness\",\n",
    "    \"extraversion\",\n",
    "    \"agreeableness\",\n",
    "    \"neuroticism\",\n",
    "]\n",
    "\n",
    "POPULATION_CONDITIONS = [\n",
    "    \"mixed\",\n",
    "    \"high_openness\",\n",
    "    \"high_conscientiousness\",\n",
    "    \"high_extraversion\",\n",
    "    \"high_agreeableness\",\n",
    "    \"high_neuroticism\",\n",
    "]\n",
    "\n",
    "\n",
    "def stable_seed(*parts: Any) -> int:\n",
    "    text = \"||\".join(str(part) for part in parts)\n",
    "    return int(\n",
    "        hashlib.sha256(text.encode(\"utf-8\")).hexdigest()[:8],\n",
    "        16\n",
    "    )\n",
    "\n",
    "\n",
    "def clipped_score(\n",
    "    rng,\n",
    "    mean=0.50,\n",
    "    sd=0.18,\n",
    "    low=0.05,\n",
    "    high=0.95,\n",
    "):\n",
    "    return float(\n",
    "        np.clip(\n",
    "            rng.normal(mean, sd),\n",
    "            low,\n",
    "            high\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "def create_agent_population(\n",
    "    n_agents=100,\n",
    "    condition=\"mixed\",\n",
    "    seed=RANDOM_SEED,\n",
    "):\n",
    "    if condition not in POPULATION_CONDITIONS:\n",
    "        raise ValueError(\n",
    "            f\"Unknown population condition '{condition}'. \"\n",
    "            f\"Choose from {POPULATION_CONDITIONS}\"\n",
    "        )\n",
    "\n",
    "    rng = np.random.default_rng(seed)\n",
    "    target_map = {\n",
    "        \"high_openness\": \"openness\",\n",
    "        \"high_conscientiousness\": \"conscientiousness\",\n",
    "        \"high_extraversion\": \"extraversion\",\n",
    "        \"high_agreeableness\": \"agreeableness\",\n",
    "        \"high_neuroticism\": \"neuroticism\",\n",
    "    }\n",
    "\n",
    "    agents = []\n",
    "\n",
    "    for agent_id in range(n_agents):\n",
    "        traits = {\n",
    "            trait: clipped_score(rng)\n",
    "            for trait in BIG5\n",
    "        }\n",
    "\n",
    "        target = target_map.get(condition)\n",
    "        if target is not None:\n",
    "            traits[target] = clipped_score(\n",
    "                rng,\n",
    "                mean=0.82,\n",
    "                sd=0.07,\n",
    "                low=0.60,\n",
    "                high=0.98,\n",
    "            )\n",
    "\n",
    "        agent = {\n",
    "            \"agent_id\": int(agent_id),\n",
    "            \"age\": str(rng.choice(AGE_GROUPS)),\n",
    "            \"gender\": str(rng.choice(GENDERS)),\n",
    "            \"education\": str(rng.choice(EDUCATION_LEVELS)),\n",
    "            \"occupation\": str(rng.choice(OCCUPATIONS)),\n",
    "            \"political_leaning\": str(rng.choice(POLITICAL_LEANINGS)),\n",
    "            **traits,\n",
    "            \"trust_level\": clipped_score(rng),\n",
    "            \"scepticism\": clipped_score(rng),\n",
    "            \"digital_literacy\": clipped_score(rng, mean=0.60),\n",
    "            \"neighbour_list\": [],\n",
    "            \"belief_state\": \"Unaware\",\n",
    "            \"sharing_history\": [],\n",
    "            \"verification_history\": [],\n",
    "            \"has_seen_information\": False,\n",
    "            \"has_shared_information\": False,\n",
    "        }\n",
    "\n",
    "        agents.append(agent)\n",
    "\n",
    "    return agents\n",
    "\n",
    "\n",
    "def validate_agents(agent_list):\n",
    "    required = {\n",
    "        \"agent_id\", \"age\", \"gender\", \"education\", \"occupation\",\n",
    "        \"political_leaning\", \"openness\", \"conscientiousness\",\n",
    "        \"extraversion\", \"agreeableness\", \"neuroticism\",\n",
    "        \"trust_level\", \"scepticism\", \"digital_literacy\",\n",
    "        \"neighbour_list\", \"belief_state\", \"sharing_history\",\n",
    "        \"verification_history\", \"has_seen_information\",\n",
    "        \"has_shared_information\",\n",
    "    }\n",
    "\n",
    "    return all(\n",
    "        required.issubset(set(agent.keys()))\n",
    "        for agent in agent_list\n",
    "    )\n",
    "\n",
    "\n",
    "agents = create_agent_population(\n",
    "    n_agents=100,\n",
    "    condition=\"mixed\",\n",
    "    seed=stable_seed(RANDOM_SEED, \"population\", \"mixed\"),\n",
    ")\n",
    "\n",
    "agents_df = pd.DataFrame(agents)\n",
    "\n",
    "print(\"Agents created:\", len(agents))\n",
    "print(\"Agents valid:\", validate_agents(agents))\n",
    "display(agents_df.head())\n",
    "display(agents_df[BIG5].describe())"
   ]
