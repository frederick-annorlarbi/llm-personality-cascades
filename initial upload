    "    # -----------------------------------------------------\n",
    "    # Check information_id\n",
    "    # -----------------------------------------------------\n",
    "\n",
    "    if \"information_id\" not in df.columns:\n",
    "        raise KeyError(\n",
    "            f\"{dataframe_name} does not contain \"\n",
    "            \"'information_id'.\"\n",
    "        )\n",
    "\n",
    "    # -----------------------------------------------------\n",
    "    # Remove old metadata columns before clean merge\n",
    "    # -----------------------------------------------------\n",
    "\n",
    "    columns_to_refresh = [\n",
    "        \"information_type\",\n",
    "        \"information_type_norm\",\n",
    "        \"stimulus_emotion\",\n",
    "        \"source_credibility\",\n",
    "        \"topic\",\n",
    "    ]\n",
    "\n",
    "    existing_refresh_columns = [\n",
    "        column\n",
    "        for column in columns_to_refresh\n",
