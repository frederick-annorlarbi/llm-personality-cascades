    "        cascade_group = cascade_group.sort_values(\n",
    "            \"step\"\n",
    "        )\n",
    "\n",
    "        final_row = cascade_group.iloc[-1]\n",
    "\n",
    "        decision_group = combined_decisions_df[\n",
    "            combined_decisions_df[\"run_id\"] == run_id\n",
    "        ]\n",
    "\n",
    "        max_step = float(\n",
    "            cascade_group[\"step\"].max()\n",
    "        )\n",
    "\n",
