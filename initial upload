    "def combine_phase8_stage_files():\n",
    "    cascade_frames = []\n",
    "    decision_frames = []\n",
    "\n",
    "    for stage_name in STAGE_DEFINITIONS:\n",
    "        cascade_file = (\n",
    "            DATA_PATH\n",
    "            / f\"phase8_checkpoint_{stage_name}_cascade.csv\"\n",
    "        )\n",
    "\n",
    "        decision_file = (\n",
    "            DATA_PATH\n",
    "            / f\"phase8_checkpoint_{stage_name}_decisions.csv\"\n",
    "        )\n",
    "\n",
    "        if cascade_file.exists():\n",
    "            frame = pd.read_csv(\n",
    "                cascade_file\n",
    "            )\n",
    "\n",
    "            if not frame.empty:\n",
    "                cascade_frames.append(\n",
    "                    frame\n",
    "                )\n",
    "\n",
    "        if decision_file.exists():\n",
    "            frame = pd.read_csv(\n",
    "                decision_file\n",
    "            )\n",
    "\n",
    "            if not frame.empty:\n",
    "                decision_frames.append(\n",
    "                    frame\n",
    "                )\n",
    "\n",
    "    combined_cascade = (\n",
    "        pd.concat(\n",
    "            cascade_frames,\n",
    "            ignore_index=True,\n",
    "        )\n",
    "        if cascade_frames\n",
    "        else pd.DataFrame()\n",
    "    )\n",
    "\n",
    "    combined_decisions = (\n",
    "        pd.concat(\n",
    "            decision_frames,\n",
    "            ignore_index=True,\n",
    "        )\n",
    "        if decision_frames\n",
    "        else pd.DataFrame()\n",
    "    )\n",
    "\n",
    "    if not combined_cascade.empty:\n",
    "        combined_cascade = (\n",
    "            combined_cascade\n",
    "            .drop_duplicates(\n",
    "                subset=[\n",
    "                    \"run_id\",\n",
    "                    \"step\",\n",
    "                ],\n",
    "                keep=\"last\",\n",
    "            )\n",
    "            .reset_index(drop=True)\n",
    "        )\n",
    "\n",
    "        combined_cascade.to_csv(\n",
    "            DATA_PATH\n",
    "            / \"phase8_all_stages_cascade_results.csv\",\n",
    "            index=False,\n",
    "        )\n",
    "\n",
    "    if not combined_decisions.empty:\n",
    "        dedupe_cols = [\n",
    "            \"run_id\",\n",
    "            \"step\",\n",
    "            \"agent_id\",\n",
    "            \"source_agent_id\",\n",
    "        ]\n",
    "\n",
    "        combined_decisions = (\n",
    "            combined_decisions\n",
    "            .drop_duplicates(\n",
    "                subset=[\n",
    "                    col\n",
    "                    for col in dedupe_cols\n",
    "                    if col in combined_decisions.columns\n",
    "                ],\n",
    "                keep=\"last\",\n",
    "            )\n",
    "            .reset_index(drop=True)\n",
    "        )\n",
    "\n",
    "        combined_decisions.to_csv(\n",
    "            DATA_PATH\n",
    "            / \"phase8_all_stages_agent_decisions.csv\",\n",
    "            index=False,\n",
    "        )\n",
    "\n",
    "    return (\n",
    "        combined_cascade,\n",
    "        combined_decisions,\n",
    "    )\n",
    "\n",
    "\n",
    "combined_cascade_df, combined_decisions_df = (\n",
