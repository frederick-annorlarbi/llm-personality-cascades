    "### Checkpointing, recovery, and stage runner\n",
    "\n",
    "This cell makes the expensive simulation resumable.\n",
    "\n",
    "- Completed run IDs are read from checkpoint CSVs.\n",
    "- Already completed runs are skipped.\n",
    "- New successful runs are appended.\n",
    "- Failures are logged separately.\n",
    "- Strict mode checks for fallback contamination.\n",
    "\n",
    "This protects long experiments against interruptions.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "3fe6b84e",
   "metadata": {},
   "outputs": [],
   "source": [
    "PHASE8_ERROR_FILE = (\n",
    "    LOGS_PATH\n",
    "    / \"phase8_failed_runs.csv\"\n",
    ")\n",
    "\n",
    "\n",
    "def append_csv(\n",
    "    dataframe,\n",
    "    path,\n",
    "):\n",
    "    if dataframe is None or dataframe.empty:\n",
    "        return\n",
    "\n",
    "    path = Path(path)\n",
    "\n",
    "    dataframe.to_csv(\n",
    "        path,\n",
    "        mode=\"a\",\n",
    "        header=not path.exists(),\n",
    "        index=False,\n",
    "    )\n",
    "\n",
    "\n",
    "def log_phase8_error(\n",
    "    stage,\n",
    "    model,\n",
    "    topology,\n",
    "    population,\n",
    "    stimulus,\n",
    "    replication,\n",
    "    error,\n",
    "):\n",
    "    row = pd.DataFrame([\n",
    "        {\n",
    "            \"timestamp\": pd.Timestamp.now().isoformat(),\n",
    "            \"stage\": stage,\n",
    "            \"model\": model,\n",
    "            \"topology\": topology,\n",
    "            \"population_condition\": population,\n",
    "            \"information_id\": stimulus,\n",
    "            \"replication\": replication,\n",
    "            \"error_type\": type(error).__name__,\n",
    "            \"error\": repr(error),\n",
    "        }\n",
    "    ])\n",
    "\n",
    "    append_csv(\n",
    "        row,\n",
    "        PHASE8_ERROR_FILE,\n",
    "    )\n",
    "\n",
    "\n",
    "def load_completed_run_ids(\n",
    "    cascade_path,\n",
    "):\n",
    "    cascade_path = Path(cascade_path)\n",
    "\n",
    "    if not cascade_path.exists():\n",
    "        return set()\n",
    "\n",
    "    try:\n",
    "        old = pd.read_csv(\n",
    "            cascade_path,\n",
    "            usecols=[\"run_id\"],\n",
    "        )\n",
    "\n",
    "        return set(\n",
    "            old[\"run_id\"].astype(str)\n",
    "        )\n",
    "\n",
    "    except Exception:\n",
    "        return set()\n",
    "\n",
    "\n",
    "def run_stage(\n",
    "    stage_name,\n",
    "    config,\n",
    "    stop_on_error=False,\n",
    "):\n",
    "    cascade_path = (\n",
    "        DATA_PATH\n",
    "        / f\"phase8_checkpoint_{stage_name}_cascade.csv\"\n",
    "    )\n",
    "\n",
    "    decision_path = (\n",
    "        DATA_PATH\n",
    "        / f\"phase8_checkpoint_{stage_name}_decisions.csv\"\n",
    "    )\n",
    "\n",
    "    completed = load_completed_run_ids(\n",
    "        cascade_path\n",
    "    )\n",
    "\n",
    "    total_runs = stage_run_count(\n",
    "        config\n",
    "    )\n",
    "\n",
    "    successful = 0\n",
    "    failed = 0\n",
    "    skipped = 0\n",
    "\n",
    "    progress = tqdm(\n",
    "        total=total_runs,\n",
    "        desc=stage_name,\n",
    "    )\n",
    "\n",
    "    for model_name, topology in config[\"model_topology_pairs\"]:\n",
    "        for population in config[\"populations\"]:\n",
    "            for stimulus_id in config[\"stimuli\"]:\n",
    "                for replication in range(\n",
    "                    1,\n",
    "                    int(config[\"replications\"]) + 1\n",
    "                ):\n",
    "                    run_id = make_run_id(\n",
    "                        model_name,\n",
    "                        topology,\n",
    "                        population,\n",
    "                        stimulus_id,\n",
    "                        replication,\n",
    "                    )\n",
    "\n",
    "                    if run_id in completed:\n",
    "                        skipped += 1\n",
    "                        progress.update(1)\n",
    "                        continue\n",
    "\n",
    "                    try:\n",
    "                        cascade_df, decisions_df, _ = run_single_simulation(\n",
    "                            model_name=model_name,\n",
    "                            topology=topology,\n",
    "                            population_condition=population,\n",
    "                            information_id=stimulus_id,\n",
    "                            replication=replication,\n",
    "                            max_steps=MAX_STEPS,\n",
    "                            n_seed_agents=N_SEED_AGENTS,\n",
    "                            use_llm=USE_LLM_FOR_EXPERIMENT,\n",
    "                            strict_llm=STRICT_LLM_MODE,\n",
    "                        )\n",
    "\n",
    "                        cascade_df = cascade_df.copy()\n",
    "                        decisions_df = decisions_df.copy()\n",
    "\n",
    "                        cascade_df[\"stage\"] = stage_name\n",
    "\n",
    "                        if not decisions_df.empty:\n",
    "                            decisions_df[\"stage\"] = stage_name\n",
    "\n",
    "                            if (\n",
    "                                STRICT_LLM_MODE\n",
    "                                and decisions_df[\"fallback_used\"].any()\n",
    "                            ):\n",
    "                                raise RuntimeError(\n",
    "                                    \"Fallback decisions detected in strict experiment.\"\n",
    "                                )\n",
    "\n",
    "                        append_csv(\n",
    "                            cascade_df,\n",
    "                            cascade_path,\n",
    "                        )\n",
    "\n",
    "                        append_csv(\n",
    "                            decisions_df,\n",
    "                            decision_path,\n",
    "                        )\n",
    "\n",
    "                        completed.add(\n",
    "                            run_id\n",
    "                        )\n",
    "\n",
    "                        successful += 1\n",
    "\n",
    "                    except Exception as exc:\n",
    "                        failed += 1\n",
    "\n",
    "                        log_phase8_error(\n",
    "                            stage=stage_name,\n",
    "                            model=model_name,\n",
    "                            topology=topology,\n",
    "                            population=population,\n",
    "                            stimulus=stimulus_id,\n",
    "                            replication=replication,\n",
    "                            error=exc,\n",
    "                        )\n",
    "\n",
    "                        print(\n",
    "                            \"\\nRun failed:\",\n",
    "                            model_name,\n",
    "                            topology,\n",
    "                            population,\n",
    "                            stimulus_id,\n",
    "                            replication,\n",
    "                            repr(exc),\n",
    "                        )\n",
    "\n",
    "                        if stop_on_error:\n",
    "                            progress.close()\n",
    "                            raise\n",
    "\n",
    "                    progress.update(1)\n",
    "\n",
    "    progress.close()\n",
    "\n",
    "    print(\n",
    "        f\"{stage_name}: \"\n",
    "        f\"{successful} successful, \"\n",
    "        f\"{failed} failed, \"\n",
    "        f\"{skipped} already completed.\"\n",
    "    )\n",
    "\n",
    "    cascade = (\n",
    "        pd.read_csv(cascade_path)\n",
    "        if cascade_path.exists()\n",
    "        else pd.DataFrame()\n",
    "    )\n",
    "\n",
    "    decisions = (\n",
    "        pd.read_csv(decision_path)\n",
    "        if decision_path.exists()\n",
    "        else pd.DataFrame()\n",
    "    )\n",
    "\n",
    "    return cascade, decisions"
   ]
  },
