    "### Create reproducible run IDs and single-run execution\n",
    "\n",
    "This cell defines how an experimental condition becomes a unique `run_id` and how a single simulation is executed.\n",
    "\n",
    "**Why the run ID matters:** checkpoint recovery, deduplication, cleaning, and later mixed-effects clustering all depend on stable run identifiers.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "51bb54a0",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "run_single_simulation() is ready.\n"
     ]
    }
   ],
   "source": [
    "def make_run_id(\n",
    "    model_name,\n",
    "    topology,\n",
    "    population_condition,\n",
    "    information_id,\n",
    "    replication,\n",
    "):\n",
    "    run_label = (\n",
    "        f\"{model_name}|{topology}|{population_condition}|\"\n",
    "        f\"{information_id}|rep{int(replication)}\"\n",
    "    )\n",
    "\n",
    "    return str(\n",
    "        uuid.uuid5(\n",
    "            uuid.NAMESPACE_DNS,\n",
    "            run_label,\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "def run_single_simulation(\n",
    "    model_name,\n",
    "    topology,\n",
    "    population_condition,\n",
    "    information_id,\n",
    "    replication,\n",
    "    max_steps=5,\n",
    "    n_seed_agents=3,\n",
    "    use_llm=True,\n",
    "    strict_llm=True,\n",
    "):\n",
    "    if model_name not in ALL_MODELS:\n",
    "        raise ValueError(\n",
    "            f\"Unknown model: {model_name}\"\n",
    "        )\n",
    "\n",
    "    if topology not in TOPOLOGIES:\n",
    "        raise ValueError(\n",
    "            f\"Unknown topology: {topology}\"\n",
    "        )\n",
    "\n",
    "    if population_condition not in POPULATION_CONDITIONS:\n",
    "        raise ValueError(\n",
    "            f\"Unknown population: {population_condition}\"\n",
    "        )\n",
    "\n",
    "    if information_id not in INFORMATION_STIMULI:\n",
    "        raise ValueError(\n",
    "            f\"Unknown information stimulus: {information_id}\"\n",
    "        )\n",
    "\n",
    "    run_id = make_run_id(\n",
    "        model_name,\n",
    "        topology,\n",
    "        population_condition,\n",
    "        information_id,\n",
    "        replication,\n",
    "    )\n",
    "\n",
    "    simulation_seed = stable_seed(\n",
    "        RANDOM_SEED,\n",
    "        \"simulation\",\n",
    "        run_id,\n",
    "    )\n",
    "\n",
    "    rng = np.random.default_rng(\n",
    "        simulation_seed\n",
    "    )\n",
    "\n",
    "    seed_agent_ids = [\n",
    "        int(x)\n",
    "        for x in rng.choice(\n",
    "            np.arange(N_AGENTS),\n",
    "            size=n_seed_agents,\n",
    "            replace=False,\n",
    "        )\n",
    "    ]\n",
    "\n",
    "    initial_state = {\n",
    "        \"agents\": [],\n",
    "        \"population_condition\": population_condition,\n",
    "        \"model\": model_name,\n",
    "        \"topology\": topology,\n",
    "        \"information\": INFORMATION_STIMULI[information_id],\n",
    "        \"replication\": int(replication),\n",
    "        \"run_id\": run_id,\n",
    "        \"simulation_seed\": int(simulation_seed),\n",
    "        \"seed_agent_ids\": seed_agent_ids,\n",
    "        \"current_step\": 1,\n",
    "        \"max_steps\": int(max_steps),\n",
    "        \"active_agents\": [],\n",
    "        \"newly_active_agents\": [],\n",
    "        \"decisions\": [],\n",
    "        \"cascade_history\": [],\n",
    "        \"use_llm\": bool(use_llm),\n",
    "        \"strict_llm\": bool(strict_llm),\n",
    "    }\n",
    "\n",
    "    final_state = app.invoke(\n",
    "        initial_state,\n",
    "        config={\n",
    "            \"recursion_limit\": max(\n",
    "                100,\n",
    "                int(max_steps) * 10 + 50,\n",
    "            )\n",
    "        },\n",
    "    )\n",
    "\n",
    "    cascade_df = pd.DataFrame(\n",
    "        final_state[\"cascade_history\"]\n",
    "    )\n",
    "\n",
    "    decisions_df = pd.DataFrame(\n",
    "        final_state[\"decisions\"]\n",
    "    )\n",
    "\n",
    "    return (\n",
    "        cascade_df,\n",
    "        decisions_df,\n",
    "        seed_agent_ids,\n",
    "    )\n",
    "\n",
    "\n",
    "print(\"run_single_simulation() is ready.\")"
   ]
  },
  {
