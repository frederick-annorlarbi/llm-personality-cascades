    "def create_communication_log(\n",
    "    decisions_dataframe\n",
    "):\n",
    "    if decisions_dataframe is None or decisions_dataframe.empty:\n",
    "        return pd.DataFrame()\n",
    "\n",
    "    communication = decisions_dataframe[\n",
    "        [\n",
    "            \"run_id\",\n",
    "            \"step\",\n",
    "            \"model\",\n",
    "            \"topology\",\n",
    "            \"population_condition\",\n",
    "            \"information_id\",\n",
    "            \"source_agent_id\",\n",
    "            \"agent_id\",\n",
    "            \"decision\",\n",
    "            \"reason\",\n",
    "        ]\n",
    "    ].copy()\n",
    "\n",
    "    communication = communication.rename(\n",
    "        columns={\n",
    "            \"agent_id\": \"target_agent_id\"\n",
    "        }\n",
    "    )\n",
    "\n",
    "    communication[\"successful_share\"] = (\n",
    "        communication[\"decision\"] == \"SHARE\"\n",
    "    )\n",
    "\n",
    "    return communication\n",
    "\n",
    "\n",
    "def build_successful_cascade_graph(\n",
    "    communication_dataframe\n",
    "):\n",
    "    graph = nx.DiGraph()\n",
    "\n",
    "    if communication_dataframe.empty:\n",
    "        return graph\n",
    "\n",
    "    successful = communication_dataframe[\n",
    "        communication_dataframe[\"successful_share\"]\n",
    "    ]\n",
    "\n",
    "    for _, row in successful.iterrows():\n",
    "        graph.add_edge(\n",
    "            int(row[\"source_agent_id\"]),\n",
    "            int(row[\"target_agent_id\"]),\n",
    "        )\n",
    "\n",
    "    return graph\n",
    "\n",
    "\n",
    "if \"test_decisions_df\" in globals():\n",
    "    communication_df = create_communication_log(\n",
    "        test_decisions_df\n",
    "    )\n",
    "\n",
    "    communication_df.to_csv(\n",
    "        DATA_PATH / \"phase6_communication_log.csv\",\n",
    "        index=False,\n",
    "    )\n",
    "\n",
    "    successful_cascade_graph = build_successful_cascade_graph(\n",
    "        communication_df\n",
    "    )\n",
    "\n",
    "    display(communication_df.head())\n",
    "else:\n",
    "    communication_df = pd.DataFrame()\n",
    "    successful_cascade_graph = nx.DiGraph()\n",
    "\n",
    "    print(\n",
    "        \"Run the optional Phase 5 smoke test if you want \"\n",
    "        \"a Phase 6 example communication log.\"\n",
    "    )"
