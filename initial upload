    "            ].isin(\n",
    "                [\n",
    "                    \"true\",\n",
    "                    \"false\",\n",
    "                ]\n",
    "            )\n",
    "        ]\n",
    "        .groupby(\n",
    "            [\n",
    "                \"model\",\n",
    "                \"topology\",\n",
    "                \"population_condition\",\n",
    "                \"information_type_norm\",\n",
    "            ],\n",
    "            observed=True,\n",
    "        )[\"cascade_size\"]\n",
    "        .mean()\n",
    "        .unstack(\n",
    "            \"information_type_norm\"\n",
    "        )\n",
    "        .reset_index()\n",
    "    )\n",
    "\n",
    "    if \"true\" not in veracity_means.columns:\n",
    "        veracity_means[\n",
    "            \"true\"\n",
    "        ] = np.nan\n",
    "\n",
    "    if \"false\" not in veracity_means.columns:\n",
    "        veracity_means[\n",
    "            \"false\"\n",
    "        ] = np.nan\n",
    "\n",
    "    veracity_means[\n",
    "        \"veracity_sensitivity\"\n",
    "    ] = (\n",
    "        veracity_means[\"true\"]\n",
    "        - veracity_means[\"false\"]\n",
    "    )\n",
    "\n",
    "    veracity_means[\n",
    "        \"false_to_true_ratio\"\n",
    "    ] = (\n",
    "        veracity_means[\"false\"]\n",
    "        / veracity_means[\n",
    "            \"true\"\n",
    "        ].replace(\n",
    "            0,\n",
    "            np.nan,\n",
    "        )\n",
    "    )\n",
    "\n",
    "    veracity_sensitivity_df = (\n",
    "        veracity_means\n",
    "    )\n",
