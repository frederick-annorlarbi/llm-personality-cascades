   "source": [
    "### Define the LangGraph simulation state\n",
    "\n",
    "This cell declares the information that moves through the LangGraph workflow: agents, model/topology identifiers, stimulus information, cascade state, and recorded decisions.\n",
    "\n",
    "Thinking of this as the simulation's 'shared memory' makes the later node functions easier to follow.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "6297b579",
   "metadata": {},
   "outputs": [],
   "source": [
    "class SimulationState(TypedDict):\n",
    "    agents: List[Dict[str, Any]]\n",
    "    population_condition: str\n",
    "    model: str\n",
    "    topology: str\n",
    "    information: Dict[str, Any]\n",
    "    replication: int\n",
    "    run_id: str\n",
    "    simulation_seed: int\n",
    "    seed_agent_ids: List[int]\n",
    "    current_step: int\n",
    "    max_steps: int\n",
    "    active_agents: List[int]\n",
    "    newly_active_agents: List[int]\n",
    "    decisions: List[Dict[str, Any]]\n",
    "    cascade_history: List[Dict[str, Any]]\n",
    "    use_llm: bool\n",
    "    strict_llm: bool"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "32c4fbb8",
   "metadata": {},
   "source": [
    "### Define the simulation workflow nodes\n",
    "\n",
    "These functions implement the main stages of a single cascade: population setup, initial information seeding, exposure/decision propagation, and final data collection.\n",
    "\n",
    "Each node reads and updates the shared `SimulationState`.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "8499d7c3",
   "metadata": {},
   "outputs": [],
   "source": [
    "def create_population_node(\n",
    "    state: SimulationState\n",
    "):\n",
    "    # Same agent profiles are reused for the same population condition.\n",
    "    population_seed = stable_seed(\n",
    "        RANDOM_SEED,\n",
    "        \"population\",\n",
    "        state[\"population_condition\"],\n",
    "    )\n",
    "\n",
    "    agent_list = create_agent_population(\n",
    "        n_agents=N_AGENTS,\n",
    "        condition=state[\"population_condition\"],\n",
    "        seed=population_seed,\n",
    "    )\n",
    "\n",
    "    # Same network instance is reused for a topology across experimental cells.\n",
    "    network_seed = stable_seed(\n",
    "        RANDOM_SEED,\n",
    "        \"network\",\n",
    "        state[\"topology\"],\n",
    "    )\n",
    "\n",
    "    graph = build_network(\n",
    "        state[\"topology\"],\n",
    "        n_agents=N_AGENTS,\n",
    "        seed=network_seed,\n",
    "    )\n",
    "\n",
    "    agent_list = attach_network_to_agents(\n",
    "        agent_list,\n",
    "        graph,\n",
    "    )\n",
    "\n",
    "    return {\n",
    "        \"agents\": agent_list\n",
    "    }\n",
    "\n",
    "\n",
    "def inject_news_node(\n",
    "    state: SimulationState\n",
    "):\n",
    "    agent_list = state[\"agents\"]\n",
    "\n",
    "    for seed_id in state[\"seed_agent_ids\"]:\n",
    "        agent = agent_list[seed_id]\n",
    "\n",
    "        agent[\"has_seen_information\"] = True\n",
    "        agent[\"has_shared_information\"] = True\n",
    "        agent[\"belief_state\"] = \"Believes\"\n",
    "\n",
    "        agent[\"sharing_history\"].append({\n",
    "            \"step\": 0,\n",
    "            \"information_id\": state[\"information\"][\"information_id\"],\n",
    "        })\n",
    "\n",
    "    return {\n",
    "        \"agents\": agent_list,\n",
    "        \"active_agents\": list(state[\"seed_agent_ids\"]),\n",
    "        \"newly_active_agents\": list(state[\"seed_agent_ids\"]),\n",
    "    }\n",
    "\n",
    "\n",
    "def agent_decision_update_node(\n",
    "    state: SimulationState\n",
    "):\n",
    "    agent_list = state[\"agents\"]\n",
    "    information = state[\"information\"]\n",
    "    current_step = state[\"current_step\"]\n",
    "    active_agents = list(state[\"active_agents\"])\n",
    "\n",
    "    lookup = {\n",
    "        agent[\"agent_id\"]: agent\n",
    "        for agent in agent_list\n",
    "    }\n",
    "\n",
    "    new_active_agents = []\n",
    "    step_decisions = []\n",
    "\n",
    "    for source_agent_id in active_agents:\n",
    "        source_agent = lookup[source_agent_id]\n",
    "\n",
    "        for neighbour_id in source_agent[\"neighbour_list\"]:\n",
    "            neighbour = lookup[neighbour_id]\n",
    "\n",
    "            if neighbour[\"has_seen_information\"]:\n",
    "                continue\n",
    "\n",
    "            neighbour[\"has_seen_information\"] = True\n",
    "            neighbour[\"belief_state\"] = \"Exposed\"\n",
    "\n",
    "            shared_neighbours = sum(\n",
    "                int(\n",
    "                    lookup[other][\"has_shared_information\"]\n",
    "                )\n",
    "                for other in neighbour[\"neighbour_list\"]\n",
    "            )\n",
    "\n",
    "            social_context = (\n",
    "                f\"Agent {source_agent_id} shared this post with you. \"\n",
    "                f\"{shared_neighbours} of your neighbours have already shared it. \"\n",
    "                f\"Current simulation step: {current_step}.\"\n",
    "            )\n",
    "\n",
    "            result = make_agent_decision(\n",
    "                agent=neighbour,\n",
    "                information=information,\n",
    "                social_context=social_context,\n",
    "                model_name=state[\"model\"],\n",
    "                use_llm=state[\"use_llm\"],\n",
    "                strict=state[\"strict_llm\"],\n",
    "                decision_seed=stable_seed(\n",
    "                    state[\"simulation_seed\"],\n",
    "                    current_step,\n",
    "                    neighbour_id,\n",
    "                ),\n",
    "            )\n",
    "\n",
    "            decision = result[\"decision\"]\n",
    "\n",
    "            if decision == \"SHARE\":\n",
    "                neighbour[\"has_shared_information\"] = True\n",
    "                neighbour[\"belief_state\"] = \"Believes\"\n",
    "\n",
    "                neighbour[\"sharing_history\"].append({\n",
    "                    \"step\": current_step,\n",
    "                    \"information_id\": information[\"information_id\"],\n",
    "                })\n",
    "\n",
    "                new_active_agents.append(\n",
    "                    neighbour_id\n",
    "                )\n",
    "\n",
    "            elif decision == \"VERIFY\":\n",
    "                neighbour[\"belief_state\"] = \"Doubts\"\n",
    "\n",
    "                neighbour[\"verification_history\"].append({\n",
    "                    \"step\": current_step,\n",
    "                    \"information_id\": information[\"information_id\"],\n",
    "                })\n",
    "\n",
    "            else:\n",
    "                neighbour[\"belief_state\"] = \"Rejects\"\n",
    "\n",
    "            step_decisions.append({\n",
    "                \"run_id\": state[\"run_id\"],\n",
    "                \"step\": current_step,\n",
    "                \"model\": state[\"model\"],\n",
    "                \"topology\": state[\"topology\"],\n",
    "                \"population_condition\": state[\"population_condition\"],\n",
    "                \"information_id\": information[\"information_id\"],\n",
    "                \"information_type\": information[\"information_type\"],\n",
    "                \"emotion\": information[\"emotional_intensity\"],\n",
    "                \"source_credibility\": information[\"source_credibility\"],\n",
    "                \"topic\": information[\"topic\"],\n",
    "                \"replication\": state[\"replication\"],\n",
    "                \"agent_id\": int(neighbour_id),\n",
    "                \"agent_cluster_id\": (\n",
    "                    f\"{state['population_condition']}\"\n",
    "                    f\"__agent_{int(neighbour_id):03d}\"\n",
    "                ),\n",
    "                \"source_agent_id\": int(source_agent_id),\n",
    "                \"decision\": decision,\n",
    "                \"shared\": int(decision == \"SHARE\"),\n",
    "                \"verified\": int(decision == \"VERIFY\"),\n",
    "                \"ignored\": int(decision == \"IGNORE\"),\n",
    "                \"reason\": result.get(\"reason\", \"\"),\n",
    "                \"used_llm\": bool(result.get(\"used_llm\", False)),\n",
    "                \"fallback_used\": bool(result.get(\"fallback_used\", False)),\n",
    "                \"llm_response\": result.get(\"llm_response\", \"\"),\n",
    "                \"openness\": neighbour[\"openness\"],\n",
    "                \"conscientiousness\": neighbour[\"conscientiousness\"],\n",
    "                \"extraversion\": neighbour[\"extraversion\"],\n",
    "                \"agreeableness\": neighbour[\"agreeableness\"],\n",
    "                \"neuroticism\": neighbour[\"neuroticism\"],\n",
    "                \"trust_level\": neighbour[\"trust_level\"],\n",
    "                \"scepticism\": neighbour[\"scepticism\"],\n",
    "                \"digital_literacy\": neighbour[\"digital_literacy\"],\n",
    "                \"network_degree\": len(neighbour[\"neighbour_list\"]),\n",
    "                \"neighbour_share_count\": int(shared_neighbours),\n",
    "            })\n",
    "\n",
    "    return {\n",
    "        \"agents\": agent_list,\n",
    "        \"active_agents\": list(dict.fromkeys(new_active_agents)),\n",
    "        \"newly_active_agents\": list(dict.fromkeys(new_active_agents)),\n",
    "        \"decisions\": state[\"decisions\"] + step_decisions,\n",
    "    }\n",
    "\n",
    "\n",
    "def record_statistics_node(\n",
    "    state: SimulationState\n",
    "):\n",
    "    agent_list = state[\"agents\"]\n",
    "    information = state[\"information\"]\n",
    "\n",
    "    record = {\n",
    "        \"run_id\": state[\"run_id\"],\n",
    "        \"step\": state[\"current_step\"],\n",
    "        \"model\": state[\"model\"],\n",
    "        \"topology\": state[\"topology\"],\n",
    "        \"population_condition\": state[\"population_condition\"],\n",
    "        \"information_id\": information[\"information_id\"],\n",
    "        \"information_type\": information[\"information_type\"],\n",
    "        \"emotion\": information[\"emotional_intensity\"],\n",
    "        \"source_credibility\": information[\"source_credibility\"],\n",
    "        \"topic\": information[\"topic\"],\n",
    "        \"replication\": state[\"replication\"],\n",
    "        \"total_seen\": sum(\n",
    "            int(agent[\"has_seen_information\"])\n",
    "            for agent in agent_list\n",
    "        ),\n",
    "        \"total_shared\": sum(\n",
    "            int(agent[\"has_shared_information\"])\n",
    "            for agent in agent_list\n",
    "        ),\n",
    "        \"total_verified\": sum(\n",
    "            int(len(agent[\"verification_history\"]) > 0)\n",
    "            for agent in agent_list\n",
    "        ),\n",
    "        \"total_ignored\": sum(\n",
    "            int(agent[\"belief_state\"] == \"Rejects\")\n",
    "            for agent in agent_list\n",
    "        ),\n",
    "        \"new_sharers\": len(\n",
    "            state[\"newly_active_agents\"]\n",
    "        ),\n",
    "    }\n",
    "\n",
    "    return {\n",
    "        \"cascade_history\": state[\"cascade_history\"] + [record],\n",
    "        \"current_step\": state[\"current_step\"] + 1,\n",
    "    }\n",
    "\n",
    "\n",
    "def should_continue(\n",
    "    state: SimulationState\n",
    "):\n",
    "    if state[\"current_step\"] > state[\"max_steps\"]:\n",
    "        return \"end\"\n",
    "\n",
    "    if len(state[\"active_agents\"]) == 0:\n",
    "        return \"end\"\n",
    "\n",
    "    return \"continue\""
   ]
  },
