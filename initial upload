    "\n",
    "def sha256_file(\n",
    "    path\n",
    "):\n",
    "    digest = hashlib.sha256()\n",
    "\n",
    "    with open(\n",
    "        path,\n",
    "        \"rb\",\n",
    "    ) as file:\n",
    "        for chunk in iter(\n",
    "            lambda: file.read(\n",
    "                1024 * 1024\n",
    "            ),\n",
    "            b\"\",\n",
    "        ):\n",
    "            digest.update(\n",
    "                chunk\n",
    "            )\n",
    "\n",
    "    return digest.hexdigest()\n",
