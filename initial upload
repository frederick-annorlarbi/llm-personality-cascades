    "### Compile the LangGraph workflow\n",
    "\n",
    "This cell connects the simulation nodes into their execution order and compiles the graph.\n",
    "\n",
    "After compilation, one consistent workflow is used across models, populations, stimuli, topologies, and replications.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "b2bf7d71",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "LangGraph cascade simulation compiled.\n"
     ]
    }
   ],
   "source": [
    "workflow = StateGraph(SimulationState)\n",
    "\n",
    "workflow.add_node(\n",
    "    \"create_population\",\n",
    "    create_population_node,\n",
    ")\n",
    "\n",
    "workflow.add_node(\n",
    "    \"inject_news\",\n",
    "    inject_news_node,\n",
    ")\n",
    "\n",
    "workflow.add_node(\n",
    "    \"agent_decision_update\",\n",
    "    agent_decision_update_node,\n",
    ")\n",
    "\n",
    "workflow.add_node(\n",
    "    \"record_statistics\",\n",
    "    record_statistics_node,\n",
    ")\n",
    "\n",
    "workflow.add_edge(\n",
    "    START,\n",
    "    \"create_population\",\n",
    ")\n",
    "\n",
    "workflow.add_edge(\n",
    "    \"create_population\",\n",
    "    \"inject_news\",\n",
    ")\n",
    "\n",
    "workflow.add_edge(\n",
    "    \"inject_news\",\n",
    "    \"agent_decision_update\",\n",
    ")\n",
    "\n",
    "workflow.add_edge(\n",
    "    \"agent_decision_update\",\n",
    "    \"record_statistics\",\n",
    ")\n",
    "\n",
    "workflow.add_conditional_edges(\n",
    "    \"record_statistics\",\n",
    "    should_continue,\n",
    "    {\n",
    "        \"continue\": \"agent_decision_update\",\n",
    "        \"end\": END,\n",
    "    },\n",
    ")\n",
    "\n",
    "app = workflow.compile()\n",
    "\n",
    "print(\"LangGraph cascade simulation compiled.\")"
   ]
  },
