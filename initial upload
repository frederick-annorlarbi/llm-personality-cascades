    "N_AGENTS = 100\n",
    "\n",
    "TOPOLOGIES = [\n",
    "    \"scale_free\",\n",
    "    \"erdos_renyi\",\n",
    "    \"watts_strogatz\",\n",
    "]\n",
    "\n",
    "CORE_TOPOLOGY = \"scale_free\"\n",
    "\n",
    "\n",
    "def build_network(\n",
    "    topology,\n",
    "    n_agents=100,\n",
    "    seed=RANDOM_SEED,\n",
    "):\n",
    "    if topology == \"scale_free\":\n",
    "        return nx.barabasi_albert_graph(\n",
    "            n=n_agents,\n",
    "            m=3,\n",
    "            seed=seed,\n",
    "        )\n",
    "\n",
    "    if topology == \"erdos_renyi\":\n",
    "        p = 6 / (n_agents - 1)\n",
    "\n",
    "        for attempt in range(100):\n",
    "            graph = nx.erdos_renyi_graph(\n",
    "                n=n_agents,\n",
    "                p=p,\n",
    "                seed=seed + attempt,\n",
    "            )\n",
    "\n",
    "            if nx.is_connected(graph):\n",
    "                return graph\n",
    "\n",
    "        # Use the largest connected component only as a last resort.\n",
    "        graph = nx.erdos_renyi_graph(\n",
    "            n=n_agents,\n",
    "            p=p,\n",
    "            seed=seed,\n",
    "        )\n",
    "\n",
    "        if not nx.is_connected(graph):\n",
    "            components = list(nx.connected_components(graph))\n",
    "            for c1, c2 in zip(components[:-1], components[1:]):\n",
    "                graph.add_edge(next(iter(c1)), next(iter(c2)))\n",
    "\n",
    "        return graph\n",
    "\n",
    "    if topology == \"watts_strogatz\":\n",
    "        return nx.connected_watts_strogatz_graph(\n",
    "            n=n_agents,\n",
    "            k=6,\n",
    "            p=0.10,\n",
    "            tries=100,\n",
    "            seed=seed,\n",
    "        )\n",
    "\n",
    "    raise ValueError(\n",
    "        f\"Unknown topology '{topology}'. \"\n",
    "        f\"Choose from {TOPOLOGIES}\"\n",
    "    )\n",
    "\n",
    "\n",
    "def attach_network_to_agents(agent_list, graph):\n",
    "    updated = copy.deepcopy(agent_list)\n",
    "\n",
    "    for agent in updated:\n",
    "        agent_id = agent[\"agent_id\"]\n",
    "        agent[\"neighbour_list\"] = list(\n",
    "            graph.neighbors(agent_id)\n",
    "        )\n",
    "\n",
    "    return updated\n",
    "\n",
    "\n",
    "def calculate_network_statistics(graph, topology):\n",
    "    degrees = [degree for _, degree in graph.degree()]\n",
    "\n",
    "    row = {\n",
    "        \"topology\": topology,\n",
    "        \"nodes\": graph.number_of_nodes(),\n",
    "        \"edges\": graph.number_of_edges(),\n",
    "        \"average_degree\": float(np.mean(degrees)),\n",
    "        \"density\": float(nx.density(graph)),\n",
    "        \"average_clustering\": float(nx.average_clustering(graph)),\n",
    "    }\n",
    "\n",
    "    if nx.is_connected(graph):\n",
    "        row[\"average_shortest_path_length\"] = float(\n",
    "            nx.average_shortest_path_length(graph)\n",
    "        )\n",
    "        row[\"diameter\"] = int(nx.diameter(graph))\n",
    "    else:\n",
    "        row[\"average_shortest_path_length\"] = np.nan\n",
    "        row[\"diameter\"] = np.nan\n",
    "\n",
    "    return row\n",
    "\n",
    "\n",
    "NETWORK_GRAPHS = {\n",
    "    topology: build_network(\n",
    "        topology,\n",
    "        n_agents=N_AGENTS,\n",
    "        seed=stable_seed(RANDOM_SEED, \"network\", topology),\n",
    "    )\n",
    "    for topology in TOPOLOGIES\n",
    "}\n",
    "\n",
    "network_stats_df = pd.DataFrame([\n",
    "    calculate_network_statistics(\n",
    "        NETWORK_GRAPHS[topology],\n",
    "        topology\n",
    "    )\n",
    "    for topology in TOPOLOGIES\n",
    "])\n",
    "\n",
    "network_stats_df.to_csv(\n",
    "    DATA_PATH / \"phase3_network_statistics.csv\",\n",
    "    index=False,\n",
    ")\n",
    "\n",
    "display(network_stats_df)"
   ]
