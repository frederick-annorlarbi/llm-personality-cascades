    "# One-time setup: VADER lexicon (fast, local, no model download required).\n",
    "import nltk\n",
    "try:\n",
    "    nltk.data.find(\"sentiment/vader_lexicon.zip\")\n",
    "except LookupError:\n",
    "    nltk.download(\"vader_lexicon\", quiet=True)\n",
    "\n",
    "from nltk.sentiment import SentimentIntensityAnalyzer\n",
    "\n",
    "vader_analyzer = SentimentIntensityAnalyzer()\n",
    "\n",
    "# Toggle: zero-shot classification is a real NLI model and is much slower than VADER.\n",
    "# Leave False for a fast first pass; set True once VADER results look sane.\n",
    "RUN_ZERO_SHOT_CLASSIFICATION = False\n",
    "\n",
    "ZERO_SHOT_LABELS = [\n",
    "    \"cautionary or skeptical\",\n",
    "    \"alarmist or fearful\",\n",
    "    \"reassuring or dismissive\",\n",
    "    \"neutral or factual\",\n",
    "]\n",
    "\n",
    "qualitative_summary_df = pd.DataFrame()\n",
    "decisions_qualitative_df = pd.DataFrame()\n",
    "\n",
    "\n",
    "def score_reason_sentiment(text):\n",
    "    text = str(text).strip()\n",
    "\n",
    "    if not text:\n",
    "        return pd.Series({\n",
    "            \"reason_word_count\": 0,\n",
    "            \"reason_sentiment_compound\": 0.0,\n",
    "            \"reason_sentiment_pos\": 0.0,\n",
    "            \"reason_sentiment_neu\": 0.0,\n",
    "            \"reason_sentiment_neg\": 0.0,\n",
    "        })\n",
    "\n",
    "    scores = vader_analyzer.polarity_scores(text)\n",
    "    words = re.findall(r\"\\b\\w+\\b\", text)\n",
    "\n",
    "    return pd.Series({\n",
    "        \"reason_word_count\": len(words),\n",
    "        \"reason_sentiment_compound\": scores[\"compound\"],\n",
    "        \"reason_sentiment_pos\": scores[\"pos\"],\n",
    "        \"reason_sentiment_neu\": scores[\"neu\"],\n",
    "        \"reason_sentiment_neg\": scores[\"neg\"],\n",
    "    })\n",
    "\n",
    "\n",
    "if (\n",
    "    not decision_analysis_df.empty\n",
    "    and \"reason\" in decision_analysis_df.columns\n",
    "):\n",
    "    sentiment_features = (\n",
    "        decision_analysis_df[\"reason\"]\n",
    "        .apply(score_reason_sentiment)\n",
    "    )\n",
    "\n",
    "    decisions_qualitative_df = pd.concat(\n",
    "        [decision_analysis_df.reset_index(drop=True), sentiment_features],\n",
    "        axis=1,\n",
    "    )\n",
    "\n",
    "    if RUN_ZERO_SHOT_CLASSIFICATION:\n",
    "        from transformers import pipeline\n",
    "\n",
    "        zero_shot_classifier = pipeline(\n",
    "            \"zero-shot-classification\",\n",
    "            model=\"valhalla/distilbart-mnli-12-1\",  # lighter than bart-large-mnli\n",
    "        )\n",
    "\n",
    "        non_empty_mask = (\n",
    "            decisions_qualitative_df[\"reason\"].astype(str).str.strip() != \"\"\n",
    "        )\n",
    "\n",
    "        reason_texts = (\n",
    "            decisions_qualitative_df.loc[non_empty_mask, \"reason\"]\n",
    "            .astype(str)\n",
    "            .tolist()\n",
    "        )\n",
    "\n",
    "        zero_shot_labels = []\n",
    "        zero_shot_scores = []\n",
    "\n",
    "        for text in tqdm(reason_texts, desc=\"zero-shot classification\"):\n",
    "            result = zero_shot_classifier(text, ZERO_SHOT_LABELS)\n",
    "            zero_shot_labels.append(result[\"labels\"][0])\n",
    "            zero_shot_scores.append(result[\"scores\"][0])\n",
    "\n",
    "        decisions_qualitative_df[\"reason_zero_shot_label\"] = \"not_classified\"\n",
    "        decisions_qualitative_df[\"reason_zero_shot_confidence\"] = np.nan\n",
    "\n",
    "        decisions_qualitative_df.loc[\n",
    "            non_empty_mask, \"reason_zero_shot_label\"\n",
    "        ] = zero_shot_labels\n",
    "\n",
    "        decisions_qualitative_df.loc[\n",
    "            non_empty_mask, \"reason_zero_shot_confidence\"\n",
    "        ] = zero_shot_scores\n",
    "\n",
    "    summary_columns = [\n",
    "        \"reason_word_count\",\n",
    "        \"reason_sentiment_compound\",\n",
    "        \"reason_sentiment_pos\",\n",
    "        \"reason_sentiment_neu\",\n",
    "        \"reason_sentiment_neg\",\n",
    "    ]\n",
    "\n",
    "    if RUN_ZERO_SHOT_CLASSIFICATION:\n",
    "        summary_columns.append(\"reason_zero_shot_confidence\")\n",
    "\n",
    "    qualitative_summary_df = (\n",
    "        decisions_qualitative_df\n",
    "        .groupby(\n",
    "            [\"model\", \"population_condition\", \"decision\"],\n",
    "            observed=True,\n",
    "        )[summary_columns]\n",
    "        .mean()\n",
    "        .round(3)\n",
    "    )\n",
    "\n",
    "    decisions_qualitative_df.to_csv(\n",
    "        DATA_PATH / \"phase27_decisions_with_reason_features.csv\",\n",
    "        index=False,\n",
    "    )\n",
    "\n",
    "    qualitative_summary_df.to_csv(\n",
    "        TABLES_PATH / \"phase27_qualitative_reason_summary.csv\"\n",
    "    )\n",
    "\n",
    "    display(qualitative_summary_df.head(30))"
   ]
