     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "sensitivity_df = pd.DataFrame()\n",
    "\n",
    "if not metrics_df.empty:\n",
    "    sensitivity_rows = []\n",
    "\n",
    "    for minimum_reach in [\n",
    "        0,\n",
    "        5,\n",
    "        10,\n",
    "        25,\n",
    "    ]:\n",
    "        subset = metrics_df[\n",
    "            metrics_df[\"cascade_reach\"]\n",
    "            >= minimum_reach\n",
    "        ]\n",
    "\n",
    "        false_subset = subset[\n",
    "            subset[\"information_type_norm\"]\n",
    "            == \"false\"\n",
    "        ]\n",
    "\n",
    "        mixed = false_subset[\n",
    "            false_subset[\n",
    "                \"population_condition\"\n",
    "            ] == \"mixed\"\n",
    "        ][\"cascade_size\"].dropna()\n",
    "\n",
    "        conscientious = false_subset[\n",
    "            false_subset[\n",
    "                \"population_condition\"\n",
    "            ] == \"high_conscientiousness\"\n",
    "        ][\"cascade_size\"].dropna()\n",
    "\n",
    "        sensitivity_rows.append({\n",
    "            \"minimum_reach\": minimum_reach,\n",
    "            \"n_runs\": len(subset),\n",
    "            \"mixed_false_mean\": (\n",
    "                mixed.mean()\n",
    "                if len(mixed)\n",
    "                else np.nan\n",
    "            ),\n",
    "            \"high_conscientiousness_false_mean\": (\n",
    "                conscientious.mean()\n",
    "                if len(conscientious)\n",
    "                else np.nan\n",
    "            ),\n",
    "            \"firewall_reduction\": (\n",
    "                mixed.mean()\n",
    "                - conscientious.mean()\n",
    "                if (\n",
    "                    len(mixed)\n",
    "                    and len(conscientious)\n",
    "                )\n",
    "                else np.nan\n",
    "            ),\n",
    "        })\n",
    "\n",
    "    sensitivity_df = pd.DataFrame(\n",
    "        sensitivity_rows\n",
    "    )\n",
    "\n",
    "    sensitivity_df.to_csv(\n",
    "        TABLES_PATH\n",
    "        / \"phase29_sensitivity_checks.csv\",\n",
    "        index=False,\n",
    "    )\n",
    "\n",
    "    display(\n",
    "        sensitivity_df\n",
    "    )"
   ]
