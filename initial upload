    "firewall_df = pd.DataFrame()\n",
    "\n",
    "if not metrics_df.empty:\n",
    "    false_metrics = metrics_df[\n",
    "        metrics_df[\"information_type_norm\"]\n",
    "        == \"false\"\n",
    "    ].copy()\n",
    "\n",
    "    firewall_rows = []\n",
    "\n",
    "    for model_name, model_df in false_metrics.groupby(\n",
    "        \"model\",\n",
    "        observed=True,\n",
    "    ):\n",
    "        mixed = model_df[\n",
    "            model_df[\"population_condition\"]\n",
    "            == \"mixed\"\n",
    "        ][\"cascade_size\"].dropna()\n",
    "\n",
    "        conscientious = model_df[\n",
    "            model_df[\"population_condition\"]\n",
    "            == \"high_conscientiousness\"\n",
    "        ][\"cascade_size\"].dropna()\n",
    "\n",
    "        if (\n",
    "            len(mixed) > 0\n",
    "            and len(conscientious) > 0\n",
    "        ):\n",
    "            reduction = (\n",
    "                mixed.mean()\n",
    "                - conscientious.mean()\n",
    "            )\n",
    "\n",
    "            percent_reduction = (\n",
    "                100 * reduction / mixed.mean()\n",
    "                if mixed.mean() != 0\n",
    "                else np.nan\n",
    "            )\n",
    "\n",
    "            t_value = np.nan\n",
    "            p_value = np.nan\n",
    "\n",
    "            if (\n",
    "                len(mixed) >= 2\n",
    "                and len(conscientious) >= 2\n",
    "            ):\n",
    "                t_value, p_value = (\n",
    "                    stats.ttest_ind(\n",
    "                        mixed,\n",
    "                        conscientious,\n",
    "                        equal_var=False,\n",
    "                    )\n",
    "                )\n",
    "\n",
    "            firewall_rows.append({\n",
    "                \"model\": model_name,\n",
    "                \"mixed_false_mean\": mixed.mean(),\n",
    "                \"high_conscientiousness_false_mean\": conscientious.mean(),\n",
    "                \"absolute_reduction\": reduction,\n",
    "                \"percent_reduction\": percent_reduction,\n",
    "                \"welch_t\": t_value,\n",
    "                \"p_value\": p_value,\n",
    "                \"n_mixed\": len(mixed),\n",
    "                \"n_high_conscientiousness\": len(conscientious),\n",
    "            })\n",
    "\n",
    "    firewall_df = pd.DataFrame(\n",
    "        firewall_rows\n",
    "    )\n",
    "\n",
    "    firewall_df.to_csv(\n",
    "        TABLES_PATH\n",
    "        / \"phase22_conscientiousness_firewall.csv\",\n",
